{
  "name": "Google Maps local business flow",
  "args": {
    "provider": "serpapi_maps",
    "query": "med spa OR salon OR fitness studio OR dental clinic New York",
    "segment": "small_business",
    "city": "New York",
    "country": "USA",
    "max_results_per_query": 30,
    "max_followup_pages": 3,
    "crawl_workers": 4,
    "out": "data/output-google-maps-local-flow"
  }
}
