# Local Docker uses PostgreSQL on port 55432 and Redis on port 6379.
DATABASE_URL=postgresql://nexstudio:nexstudio@localhost:55432/nexstudio
REDIS_URL=redis://localhost:6379

# Optional integrations. Apollo CSV mode works without an Apollo API key.
APOLLO_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=hello@example.com
NEXTAUTH_SECRET=replace-with-a-random-32-character-secret
NEXTAUTH_URL=http://localhost:3000
