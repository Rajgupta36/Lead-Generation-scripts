{
  "name": "lead-generator-turbo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "pnpm typecheck",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @nexstudio/web dev",
    "dev:worker": "pnpm --filter @nexstudio/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @nexstudio/db db:generate",
    "db:push": "pnpm --filter @nexstudio/db db:push",
    "db:migrate": "pnpm --filter @nexstudio/db db:migrate",
    "deploy:web": "pnpm --filter @nexstudio/web build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "next": "^15.5.22",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  }
}
